# Environment Configuration for Leave Management System
# Copy this file to .env and update with your actual values

# ============================================================================
# Database Configuration
# ============================================================================

# PostgreSQL connection URL
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/leave_management

# ============================================================================
# Authentication Configuration
# ============================================================================

# JWT Secret Key - MUST BE CHANGED IN PRODUCTION
# Generate with: openssl rand -hex 32
SECRET_KEY=super-secret-key-change-in-production

# JWT Token Expiry (minutes)
# Default: 1440 (24 hours)
# JWT_EXPIRE_MINUTES=1440

# ============================================================================
# RabbitMQ Configuration
# ============================================================================

# RabbitMQ connection URL
# Format: amqp://username:password@host:port/
RABBITMQ_URL=amqp://guest:guest@rabbitmq/

# RabbitMQ Management Interface (for monitoring)
# RABBITMQ_MANAGEMENT_URL=http://rabbitmq:15672

# ============================================================================
# Service Discovery (Consul)
# ============================================================================

# Consul host address
CONSUL_HOST=consul

# Consul port
CONSUL_PORT=8500

# ============================================================================
# Service Registration
# ============================================================================

# Internal service hostname (for Consul registration)
SERVICE_HOST=auth-service

# Internal service port
SERVICE_PORT=8001

# ============================================================================
# OpenTelemetry (Distributed Tracing)
# ============================================================================

# OTLP Collector endpoint (gRPC)
OTEL_COLLECTOR_URL=http://otel-collector:4317

# Enable tracing (true/false)
# OTEL_ENABLE_TRACING=true

# Service name for tracing
# OTEL_SERVICE_NAME=auth-service

# ============================================================================
# Notification Service Configuration
# ============================================================================

# Maximum number of retries for RabbitMQ connection
NOTIFICATION_MAX_RETRIES=3

# Delay between retries (seconds)
NOTIFICATION_RETRY_DELAY=5

# ============================================================================
# Service URLs (for inter-service communication)
# ============================================================================

# Employee Service URL (used by Leave Service)
EMPLOYEE_SERVICE_URL=http://employee-service:8002

# Auth Service URL (used by other services if needed)
# AUTH_SERVICE_URL=http://auth-service:8001

# Leave Service URL (used by other services if needed)
# LEAVE_SERVICE_URL=http://leave-service:8003

# Notification Service URL (used by other services if needed)
# NOTIFICATION_SERVICE_URL=http://notification-service:8004

# ============================================================================
# Logging Configuration
# ============================================================================

# Log Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ============================================================================
# API Gateway Configuration (Traefik)
# ============================================================================

# Enable Traefik dashboard
# TRAEFIK_DASHBOARD=true

# Traefik API port
# TRAEFIK_API_PORT=8080

# ============================================================================
# Development/Testing Configuration
# ============================================================================

# Debug mode (true/false)
# DEBUG=false

# Seed default users on startup (true/false)
# SEED_DEFAULT_USERS=true

# ============================================================================
# Production Configuration (Example)
# ============================================================================
# Uncomment and update for production deployments

# SECRET_KEY=<generate-with-openssl-rand-hex-32>
# DATABASE_URL=postgresql://prod_user:prod_password@prod-db-host:5432/leave_mgmt_prod
# RABBITMQ_URL=amqp://rabbitmq_user:rabbitmq_password@rabbit-prod:5672/
# LOG_LEVEL=WARNING
# DEBUG=false

# ============================================================================
# Important Notes
# ============================================================================
# 1. NEVER commit the actual .env file with secrets to version control
# 2. Use strong, randomly generated SECRET_KEY in production
# 3. Update DATABASE credentials for production databases
# 4. Use RabbitMQ credentials in production
# 5. Enable HTTPS/TLS on API Gateway for production
# 6. Consider using a secrets management system (Vault, AWS Secrets Manager)
# 7. Rotate secrets regularly
# 8. Use different credentials for different environments
# ============================================================================
